# Wallet that receives payments. Use the receive address shown by
# `kpass wallet address` or any EOA you control on the Kite chain.
PAY_TO=0xYourKiteWalletAddress

# mainnet (USDC.e on eip155:2366) or testnet (pieUSD on eip155:2368)
KITE_NETWORK=mainnet

# The API you are wrapping. /v1/<path> on this service proxies to UPSTREAM_URL/<path>.
UPSTREAM_URL=https://api.open-meteo.com
# Optional credential injected into every upstream request.
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=

# Price per call in USD, charged in the network's stablecoin.
PRICE_USD=0.001
SERVICE_DESCRIPTION=Open-Meteo forecast behind x402 on Kite

PORT=8080
# Public origin clients reach this service on. Defaults to https://<Host header>,
# which is right unless a proxy in front of you rewrites Host.
# PUBLIC_BASE_URL=https://your-service.example.com
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
